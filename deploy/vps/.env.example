# Copy to .env on the VPS. Never commit or send the populated file.
SITE_DOMAIN=gosour.net
ACME_EMAIL=ops@gosour.net

# Generate a unique value: openssl rand -base64 48
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SIGNING_KEY=replace-with-at-least-64-random-characters
BOOTSTRAP_RUN_ON_STARTUP=false

# --- Mode switch: use ./mode.sh demo | live (it edits these three for you) ---
# demo = Staging + ClientDemoMode: runs WITHOUT Twilio/Azure (Atmaen phone-OTP disabled).
# live = Production: Azure Key Vault + Twilio below are REQUIRED.
APP_ENVIRONMENT=Production
CLIENT_DEMO_MODE=false
# Only used in demo mode. Generated by ./mode.sh demo (openssl rand -base64 32). Keep it stable.
FIELD_ENCRYPTION_LOCAL_KEY=

# Production field encryption: Azure Key Vault + identity credentials.
FIELD_ENCRYPTION_KEY_VAULT_URI=https://YOUR-VAULT.vault.azure.net/
FIELD_ENCRYPTION_KEY_NAME=jusoor-field-encryption
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# Production SMS verification.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Image/video storage used by the CMS.
SUPABASE_URL=
SUPABASE_STORAGE_BUCKET=jusoor-media
SUPABASE_SERVICE_ROLE_KEY=

# Newsroom logins created on startup when BOOTSTRAP_RUN_ON_STARTUP=true (up to 5 slots).
# Role defaults to EditorInChief; set NEWSROOM_n_ROLE to any NewsroomRole to override.
# Existing users keep their current password. Use strong unique passwords for anything public.
NEWSROOM_1_EMAIL=
NEWSROOM_1_PASSWORD=
NEWSROOM_1_NAME=
NEWSROOM_1_ROLE=EditorInChief
