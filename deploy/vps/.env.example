# Copy to .env on the VPS. Never commit or send the populated file.
SITE_DOMAIN=gosour.net
ACME_EMAIL=ops@gosour.net

# Generate a unique value: openssl rand -base64 48
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SIGNING_KEY=replace-with-at-least-64-random-characters
BOOTSTRAP_RUN_ON_STARTUP=false

# Production field encryption: Azure Key Vault + identity credentials.
FIELD_ENCRYPTION_KEY_VAULT_URI=https://YOUR-VAULT.vault.azure.net/
FIELD_ENCRYPTION_KEY_NAME=jusoor-field-encryption
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=

# Production SMS verification.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Image/video storage used by the CMS.
SUPABASE_URL=
SUPABASE_STORAGE_BUCKET=jusoor-media
SUPABASE_SERVICE_ROLE_KEY=
