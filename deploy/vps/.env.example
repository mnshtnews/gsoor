# Copy to .env on the VPS. Never commit or send the populated file.
SITE_DOMAIN=gosour.net
ACME_EMAIL=ops@gosour.net

POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SIGNING_KEY=replace-with-at-least-64-random-characters
BOOTSTRAP_RUN_ON_STARTUP=false

# Use bash ./mode.sh demo | live. The script manages these flags.
APP_ENVIRONMENT=Production
CLIENT_DEMO_MODE=false
VPS_FIELD_ENCRYPTION=false

# Transitional only: mode.sh imports this existing demo key into the protected
# key-ring secret once, then clears this setting. Keep it stable until imported.
FIELD_ENCRYPTION_LOCAL_KEY=

# Optional Azure Key Vault provider. Only required when VPS_FIELD_ENCRYPTION=false.
FIELD_ENCRYPTION_KEY_VAULT_URI=
FIELD_ENCRYPTION_KEY_NAME=
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=

# Azure Translator is separate from field encryption.
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# Production SMS verification (required by mode.sh live).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Image/video storage used by the CMS.
SUPABASE_URL=
SUPABASE_STORAGE_BUCKET=jusoor-media
SUPABASE_SERVICE_ROLE_KEY=

# Newsroom logins created on startup when BOOTSTRAP_RUN_ON_STARTUP=true (up to 5 slots).
# Role defaults to EditorInChief; set NEWSROOM_n_ROLE to any NewsroomRole to override.
# Existing users keep their current password. Use strong unique passwords for anything public.
NEWSROOM_1_EMAIL=
NEWSROOM_1_PASSWORD=
NEWSROOM_1_NAME=
NEWSROOM_1_ROLE=EditorInChief
